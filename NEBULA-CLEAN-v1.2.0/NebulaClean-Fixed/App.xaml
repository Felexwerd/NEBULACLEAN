<Application x:Class="NebulaClean.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
 <Application.Resources>
  <Color x:Key="BgColor">#0B0D14</Color>
  <Color x:Key="PanelColor">#0F121D</Color>
  <Color x:Key="CardColor">#191E2E</Color>
  <Color x:Key="AccentColor">#8B5CF6</Color>
  <Color x:Key="CyanColor">#22D3EE</Color>
  <Color x:Key="TextColor">#F8FAFC</Color>
  <Color x:Key="MutedColor">#98A2B8</Color>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#252B40"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="16,11"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.84"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="15,12"/>
   <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F8FAFC"/>
   <Setter Property="Background" Value="#191E2E"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#382B5C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#5B3AA5"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Application.Resources>
</Application>

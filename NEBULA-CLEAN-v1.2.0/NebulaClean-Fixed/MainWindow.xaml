ce MutedBrush}" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="ProfilePage" Visibility="Collapsed"><Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" BorderBrush="#272D42" BorderThickness="1"><StackPanel><TextBlock Text="Профиль" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ваше имя в чате, префикс и аватар." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/><Border Background="#202538" CornerRadius="14" Padding="18"><StackPanel><Border Width="104" Height="104" CornerRadius="52" Background="#38285C" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True"><Grid><TextBlock x:Name="ProfileAvatarFallback" Text="✦" FontSize="48" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ProfileAvatarImage" Stretch="UniformToFill"/></Grid></Border><TextBlock x:Name="ProfileEmail" Text="Аккаунт" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,16"/><Button Content="Выбрать аватарку…" Click="ChooseAvatar_Click" HorizontalAlignment="Center" Background="#7C3AED"/><TextBlock Text="Префикс в чате" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/><TextBox x:Name="ProfilePrefixBox" Text="" MaxLength="16" Height="40" Padding="10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/><Button Content="Сохранить профиль" Click="SaveProfile_Click" Background="#0E7490" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="ProfileStatus" Foreground="#6EE7B7" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></Border></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" BorderBrush="#272D42" BorderThickness="1"><StackPanel><TextBlock Text="Настройки аккаунта" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AccountEmailText" Text="Аккаунт" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/><Border Background="#202538" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Изменить пароль" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Доступно для аккаунтов, созданных по почте и паролю." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/><Grid Height="42"><PasswordBox x:Name="CurrentPasswordBox" Height="40" Padding="10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#51436F" PasswordChanged="PasswordFields_Changed"/><TextBlock x:Name="CurrentPasswordHint" Text="Введите текущий пароль" Foreground="#77819A" Opacity="0.78" Margin="12,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Grid Height="42" Margin="0,9,0,0"><PasswordBox x:Name="NewPasswordBox" Height="40" Padding="10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#51436F" PasswordChanged="PasswordFields_Changed"/><TextBlock x:Name="NewPasswordHint" Text="Введите новый пароль (минимум 8 символов)" Foreground="#77819A" Opacity="0.78" Margin="12,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Grid Height="42" Margin="0,9,0,0"><PasswordBox x:Name="ConfirmNewPasswordBox" Height="40" Padding="10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#51436F" PasswordChanged="PasswordFields_Changed"/><TextBlock x:Name="ConfirmPasswordHint" Text="Повторите новый пароль" Foreground="#77819A" Opacity="0.78" Margin="12,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button Content="Сохранить новый пароль" Click="ChangePassword_Click" Background="#7C3AED" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="PasswordStatus" FontSize="11" Foreground="#6EE7B7" Margin="0,9,0,0"/></StackPanel></Border><Border Background="#202538" CornerRadius="12" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="Язык интерфейса" FontWeight="SemiBold"/><TextBlock Text="По умолчанию используется English. Выберите язык и перезапустите приложение для полного применения." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/><ComboBox x:Name="LanguageSelector" Height="38" SelectedIndex="0" SelectionChanged="LanguageSelector_SelectionChanged"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="Беларуская" Tag="be"/><ComboBoxItem Content="Українська" Tag="uk"/></ComboBox><TextBlock x:Name="LanguageStatus" FontSize="11" Foreground="#6EE7B7" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#202538" CornerRadius="12" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="Безопасность очистки" FontWeight="SemiBold"/><TextBlock Text="Перед удалением всегда требуется подтверждение. Файлы, которые заняты или недоступны, пропускаются." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border><Button Content="Выйти из аккаунта" Click="Logout_Click" Background="#7F1D1D" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>

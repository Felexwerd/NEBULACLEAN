<Window x:Class="NebulaClean.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEBULA CLEAN" Height="820" Width="1320" MinHeight="720" MinWidth="1100"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
 Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0F121D" BorderBrush="#242A3B" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,22,18,18">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="5,4,0,34">
      <Border Width="40" Height="40" CornerRadius="13">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#22D3EE" Offset="1"/></LinearGradientBrush></Border.Background>
       <TextBlock Text="✦" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
       <TextBlock Text="NEBULA" FontSize="17" FontWeight="Bold"/>
       <TextBlock Text="C L E A N" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" FontWeight="Bold" Foreground="#69738B" Margin="9,0,0,12"/>
     <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Background="#27213F" Foreground="#C4B5FD" Click="NavDashboard_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="18" Width="29"/><TextBlock x:Name="NavDashboardLabel" Text="Главная" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavCleaner" Style="{StaticResource NavButton}" Click="NavCleaner_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="✧" FontSize="18" Width="29"/><TextBlock x:Name="NavCleanerLabel" Text="Очистка мусора" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavAnalyzer" Style="{StaticResource NavButton}" Click="NavAnalyzer_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="18" Width="29"/><TextBlock x:Name="NavAnalyzerLabel" Text="Анализ диска" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavSubscriptions" Style="{StaticResource NavButton}" Click="Subscriptions_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="✧" FontSize="18" Width="29"/><TextBlock x:Name="NavSubscriptionsLabel" Text="Подписки" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Click="NavHistory_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="18" Width="29"/><TextBlock x:Name="NavHistoryLabel" Text="История" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavChat" Style="{StaticResource NavButton}" Click="NavChat_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="✉" FontSize="18" Width="29"/><TextBlock x:Name="NavChatLabel" Text="Чат" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="NavProfile" Style="{StaticResource NavButton}" Click="NavProfile_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="18" Width="29"/><TextBlock x:Name="NavProfileLabel" Text="Профиль" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#171B2A" CornerRadius="13" Padding="14" Margin="0,0,0,13">
      <StackPanel><TextBlock Text="ЗАЩИТА ДАННЫХ" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC"/><TextBlock Text="Перед удалением вы увидите, что именно будет очищено." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" LineHeight="17"/></StackPanel>
     </Border>
     <Button Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="29"/><TextBlock x:Name="SettingsNavLabel" Text="Настройки" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Click="Logout_Click" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="⇥" FontSize="18" Width="29"/><TextBlock x:Name="LogoutNavLabel" Text="Выйти из аккаунта" VerticalAlignment="Center"/></StackPanel></Button>
     <TextBlock Text="NEBULA CLEAN  •  ACCOUNT" FontSize="9" Foreground="#566078" Margin="10,14,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,27,34,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,24">
    <StackPanel><TextBlock x:Name="PageEyebrow" Text="ОБЗОР СИСТЕМЫ" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Всё под контролем." FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PageSubtitle" Text="Проверим, что занимает место на вашем компьютере." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#151B2A" BorderBrush="#293148" BorderThickness="1" CornerRadius="11" Padding="13,9"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Локальный режим" FontSize="11" Foreground="#C7D2E8"/></StackPanel></Border>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Grid x:Name="DashboardPage">
      <Grid.RowDefinitions><RowDefinition Height="225"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.ColumnSpan="2" CornerRadius="20" Padding="26" BorderBrush="#30304E" BorderThickness="1">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#242043" Offset="0"/><GradientStop Color="#171B2D" Offset="0.62"/><GradientStop Color="#132A3B" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Background="#382B5C" CornerRadius="7" Padding="12,9" MinWidth="62"><TextBlock x:Name="DriveLabel" Text="◈  ДИСК" FontSize="13" FontWeight="Bold" Foreground="#F3EEFF"/></Border><ComboBox x:Name="DriveSelector" Width="250" Height="40" Margin="9,0,0,0" Padding="10,5" SelectionChanged="DriveSelector_SelectionChanged" Background="#1A2032" Foreground="#F8FAFC" BorderBrush="#6D50B5" BorderThickness="1" FontSize="15" IsTextSearchEnabled="True" IsEditable="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ComboBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#171C2B"/><SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3EEFF"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#493477"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F3EEFF"/><Setter Property="Background" Value="#171C2B"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#493477"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#382B5C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ComboBox.Resources>
          <ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="8,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="#F3EEFF" TextElement.FontSize="15" TextElement.FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="⌄" FontSize="16" Foreground="#B9A5FF" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#171C2B" BorderBrush="#6D50B5" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="220" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropToggle" Property="BorderBrush" Value="#A78BFA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ComboBox.Template></ComboBox></StackPanel>
         <TextBlock Text="Освободим место." FontSize="27" FontWeight="SemiBold" Margin="0,15,0,5"/>
         <TextBlock Text="Найдите временные файлы и освободите место без лишнего риска." FontSize="12" Foreground="#B0B8D0" TextWrapping="Wrap" MaxWidth="450" LineHeight="19"/>
         <Button Content="Начать сканирование  →" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,19,0,0" Click="Scan_Click" Padding="18,12"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Ellipse Stroke="#343653" StrokeThickness="13"/>
         <Ellipse Stroke="#8B5CF6" StrokeThickness="13" StrokeDashArray="2 1"><Ellipse.RenderTransform><RotateTransform x:Name="DiskRingRotate" Angle="-90" CenterX="95" CenterY="95"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="DiskRingRotate" Storyboard.TargetProperty="Angle" From="-90" To="270" Duration="0:0:18"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="DiskFreePercent" Text="—" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="свободно" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
       </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,18,9,0" BorderBrush="#272D42" BorderThickness="1">
       <StackPanel><TextBlock Text="СВОБОДНО НА ВЫБРАННОМ ДИСКЕ:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DiskFreeText" Text="Определяем…" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock x:Name="DiskTotalText" Text="Общий объём: —" FontSize="11" Foreground="{StaticResource MutedBrush}"/><ProgressBar x:Name="DiskUsageBar" Height="5" Margin="0,17,0,0" Minimum="0" Maximum="100" Value="0" Background="#30364A" Foreground="#8B5CF6" BorderThickness="0"/></StackPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="9,18,0,0" BorderBrush="#272D42" BorderThickness="1">
       <StackPanel><TextBlock Text="ПОТЕНЦИАЛЬНАЯ ОЧИСТКА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PotentialCleanupText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock x:Name="PotentialFilesText" Text="Запустите сканирование" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
      </Border>
      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#151A29" CornerRadius="16" Padding="20" Margin="0,18,0,0" BorderBrush="#272D42" BorderThickness="1">
       <StackPanel><DockPanel><TextBlock Text="Быстрые действия" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="РЕКОМЕНДУЕМ" Foreground="#A78BFA" FontSize="10" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button Grid.Column="0" Background="#25213B" Click="Scan_Click" Margin="0,0,7,0" Padding="13"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="20" Foreground="#C4B5FD" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Проверить мусор" FontSize="12"/><TextBlock Text="Сканирование" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
         <Button Grid.Column="1" Click="NavAnalyzer_Click" Margin="4,0" Padding="13"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="20" Foreground="#67E8F9" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Большие файлы" FontSize="12"/><TextBlock Text="Открыть анализатор" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
         <Button Grid.Column="2" Click="NavHistory_Click" Margin="7,0,0,0" Padding="13"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="20" Foreground="#6EE7B7" Margin="0,0,9,0"/><StackPanel><TextBlock Text="История" FontSize="12"/><TextBlock Text="Результаты очисток" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
        </Grid>
       </StackPanel>
      </Border>
     </Grid>
     <StackPanel x:Name="CleanerPage" Visibility="Collapsed">
      <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22" BorderBrush="#272D42" BorderThickness="1">
       <StackPanel><DockPanel><StackPanel><TextBlock Text="Категории очистки" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Сканирование ничего не удаляет." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Content="Сканировать" Background="{StaticResource AccentBrush}" Click="Scan_Click" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
        <ItemsControl x:Name="CategoryList" Margin="0,19,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202538" CornerRadius="12" Padding="15" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="7,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding LocationLabel}" FontSize="10" Foreground="#69748E" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <DockPanel Margin="0,8,0,0"><StackPanel><TextBlock x:Name="CleanerTotalText" Text="Найдено: —" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Обрабатываются только файлы верхнего уровня выбранных папок." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Content="Очистить выбранное" Background="#7C3AED" Click="Clean_Click" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="19,13"/></DockPanel>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="AnalyzerPage" Visibility="Collapsed">
      <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22" BorderBrush="#272D42" BorderThickness="1" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Анализ выбранного диска" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AnalyzerDiskSummary" Text="Загрузка данных…" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><ProgressBar x:Name="AnalyzerUsageBar" Height="7" Minimum="0" Maximum="100" Background="#30364A" Foreground="#22D3EE" BorderThickness="0"/></StackPanel>
      </Border>
      <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22" BorderBrush="#272D42" BorderThickness="1">
       <StackPanel><DockPanel><StackPanel><TextBlock Text="Большие файлы" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Ищет крупные файлы на выбранном диске. Само по себе ничего не удаляет." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><Button Content="Найти большие файлы" Click="LargeFilesScan_Click" Background="{StaticResource AccentBrush}" Padding="16,11" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,12"><TextBlock Text="Минимальный размер:" FontSize="12" VerticalAlignment="Center"/><ComboBox x:Name="LargeFilesThreshold" Width="130" Margin="10,0,0,0" SelectedIndex="1"><ComboBoxItem Content="100 МБ" Tag="104857600"/><ComboBoxItem Content="500 МБ" Tag="524288000"/><ComboBoxItem Content="1 ГБ" Tag="1073741824"/><ComboBoxItem Content="5 ГБ" Tag="5368709120"/></ComboBox><TextBlock x:Name="LargeFilesSummary" Text="Сканирование ещё не запускалось" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
        <DataGrid x:Name="LargeFilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#171B29" Foreground="#E8ECF8" BorderBrush="#30364A" RowBackground="#202538" AlternatingRowBackground="#1B2030" Height="330"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="Расположение" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0"><Button Content="Открыть расположение" Click="OpenLargeFileLocation_Click" Padding="14,10" Margin="0,0,9,0"/><Button Content="Удалить выбранный файл…" Click="DeleteLargeFile_Click" Background="#7F1D1D" Padding="14,10"/></StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed"><Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" BorderBrush="#272D42" BorderThickness="1"><StackPanel><TextBlock Text="История операций" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistoryText" Text="Пока очисток не было. Результаты появятся здесь после первой операции." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="19"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="SubscriptionsPage" Visibility="Collapsed"><Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" BorderBrush="#272D42" BorderThickness="1"><StackPanel><TextBlock Text="Ваши подписки" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Выберите бесплатный план или активируйте промокод." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#202538" CornerRadius="14" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="FREE" Foreground="#67E8F9" FontSize="11" FontWeight="Bold"/><TextBlock Text="Бесплатная" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Базовые функции очистки и анализа диска." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="FreePlanStatus" Text="Доступна всем" Foreground="#6EE7B7" Margin="0,15,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#2B2145" CornerRadius="14" Padding="18" Margin="8,0,0,0" BorderBrush="#7052B9" BorderThickness="1"><StackPanel><TextBlock Text="PROMO" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/><TextBlock Text="По промокоду" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Временный доступ по коду, который создаёт администратор." TextWrapping="Wrap" Foreground="#C1B9D9" FontSize="12"/><TextBlock x:Name="PromoPlanStatus" Text="Не активирована" Foreground="#C4B5FD" Margin="0,15,0,0"/></StackPanel></Border></Grid><TextBlock x:Name="SubscriptionDetail" Text="Загрузка подписки…" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,8"/><TextBlock Text="ПРОМОКОД" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,7"/><DockPanel><TextBox x:Name="PromoCodeBox" MinWidth="320" Height="54" Padding="16,12" Background="#F8FAFC" Foreground="#111827" BorderBrush="#8B5CF6" BorderThickness="2" FontSize="16" VerticalContentAlignment="Center"/><Button Content="Активировать" Click="RedeemPromo_Click" Background="#7C3AED" MinWidth="170" MinHeight="54" FontSize="15" Margin="12,0,0,0"/></DockPanel><TextBlock x:Name="PromoStatus" Text="" Foreground="#6EE7B7" FontSize="11" Margin="0,9,0,0"/><Border x:Name="AdminPromoPanel" Visibility="Collapsed" Background="#151A29" CornerRadius="14" Padding="18" Margin="0,22,0,0"><StackPanel><TextBlock Text="АДМИН-ПАНЕЛЬ · ПРОМОКОДЫ" FontSize="11" FontWeight="Bold" Foreground="#F0ABFC"/><TextBlock Text="Создать код с ограниченным сроком и количеством активаций." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><TextBox x:Name="AdminPromoCodeBox" Height="38" Padding="10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/><Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Срок, дней" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="PromoDaysBox" Text="30" Height="36" Padding="9" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Макс. активаций" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="PromoUsesBox" Text="1" Height="36" Padding="9" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/></StackPanel></Grid><Button Content="Создать промокод" Click="CreatePromo_Click" Background="#9333EA" HorizontalAlignment="Left"/><TextBlock x:Name="AdminPromoResult" Text="" Foreground="#6EE7B7" FontSize="11" Margin="0,9,0,0"/><Separator Margin="0,18,0,14" Background="#34304D"/><TextBlock Text="ПРИНУДИТЕЛЬНОЕ ОБНОВЛЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="#67E8F9"/><TextBlock Text="Версии ниже минимальной будут заблокированы при следующем входе." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Последняя версия" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="LatestVersionBox" Text="1.1.0" Height="36" Padding="9" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Минимальная версия" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="MinimumVersionBox" Text="1.1.0" Height="36" Padding="9" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/></StackPanel></Grid><TextBlock Text="Ссылка на скачивание обновления" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><TextBox x:Name="UpdateUrlBox" Text="https://example.com/nebula-clean" Height="36" Padding="9" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/><TextBlock Text="Сообщение пользователям" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><TextBox x:Name="UpdateMessageBox" Text="Установите актуальную версию NEBULA CLEAN." Height="60" Padding="9" TextWrapping="Wrap" AcceptsReturn="True" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51"/><Button Content="Опубликовать требования обновления" Click="PublishVersion_Click" Background="#0E7490" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="VersionAdminResult" Text="" Foreground="#6EE7B7" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></Border></StackPanel>
     <StackPanel x:Name="ChatPage" Visibility="Collapsed"><Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22" BorderBrush="#272D42" BorderThickness="1"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Общий чат NEBULA" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Сообщения видны вошедшим пользователям приложения." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Обновить" Click="RefreshChat_Click" VerticalAlignment="Top" MinWidth="110" Height="38" Margin="12,0,0,0"/></Grid><ListBox x:Name="ChatMessagesList" Height="360" Background="#101421" Foreground="#F8FAFC" BorderBrush="#30364A" Margin="0,0,0,12" SelectionChanged="ChatMessagesList_SelectionChanged" FontSize="13" Padding="8"><ListBox.ItemTemplate><DataTemplate><Border Background="#191E30" CornerRadius="10" Padding="9" Margin="0,0,0,7" MouseLeftButtonDown="ChatMessage_DoubleClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="✦" Tag="{Binding}" Click="ChatAvatar_Click" Loaded="ChatAvatar_Loaded" Width="38" Height="38" FontSize="18" Background="#38285C" Foreground="#C4B5FD" BorderThickness="0" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding Email}" FontWeight="SemiBold" Foreground="#F8FAFC"/><TextBlock Text="{Binding CreatedAtUtc, StringFormat={}{0:HH:mm}}" Foreground="#929BB5" FontSize="10" HorizontalAlignment="Right"/></DockPanel><TextBlock Foreground="#C4B5FD" FontSize="11"><Run Text="{Binding DisplayPrefix}"/><Run Text="  ·  "/><Run Text="{Binding Role}"/></TextBlock><TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" Foreground="#E5E7EB" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
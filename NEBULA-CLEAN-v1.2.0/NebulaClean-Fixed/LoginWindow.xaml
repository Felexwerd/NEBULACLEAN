<Window x:Class="NebulaClean.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEBULA CLEAN — Аккаунт" Height="690" Width="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#0B0D14" Foreground="#F8FAFC" FontFamily="Segoe UI">
<Grid Margin="34"><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25"><Border Width="48" Height="48" CornerRadius="15"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6"/><GradientStop Color="#22D3EE" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="✦" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="NEBULA CLEAN" FontSize="21" FontWeight="Bold"/><TextBlock Text="ВАШЕ ПРОСТРАНСТВО. ВАШ КОНТРОЛЬ." FontSize="9" Foreground="#98A2B8" Margin="0,3,0,0"/></StackPanel></StackPanel>
<Border Background="#191E2E" BorderBrush="#30364A" BorderThickness="1" CornerRadius="20" Padding="26"><StackPanel><TextBlock x:Name="FormTitle" Text="Добро пожаловать" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="FormSubtitle" Text="Войдите, чтобы синхронизировать подписку и аккаунт." Foreground="#98A2B8" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,22"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="LoginTab" Content="Вход" Click="LoginTab_Click" Background="#4C328B" Width="100"/><Button x:Name="RegisterTab" Content="Регистрация" Click="RegisterTab_Click" Margin="8,0,0,0" Width="120"/></StackPanel>
<TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА" FontSize="10" FontWeight="Bold" Foreground="#98A2B8" Margin="0,0,0,7"/><TextBox x:Name="EmailBox" Height="42" Padding="12,10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51" FontSize="13"/>
<TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="Bold" Foreground="#98A2B8" Margin="0,16,0,7"/><PasswordBox x:Name="PasswordBox" Height="42" Padding="12,10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51" FontSize="13"/>
<StackPanel x:Name="ConfirmPanel" Visibility="Collapsed"><TextBlock Text="ПОВТОРИТЕ ПАРОЛЬ" FontSize="10" FontWeight="Bold" Foreground="#98A2B8" Margin="0,16,0,7"/><PasswordBox x:Name="ConfirmPasswordBox" Height="42" Padding="12,10" Background="#101421" Foreground="#F8FAFC" BorderBrush="#343B51" FontSize="13"/></StackPanel>
<Button x:Name="SubmitButton" Content="Войти в аккаунт  →" Click="Submit_Click" Background="#7C3AED" Height="46" Margin="0,21,0,12"/><Button Content="◎  Продолжить с Google" Click="Google_Click" Height="43" Background="#252B40"/><TextBlock x:Name="StatusLabel" Text="" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/><TextBlock Text="Подписки и промокоды синхронизируются через сервер NEBULA." Foreground="#69748E" FontSize="10" TextWrapping="Wrap" Margin="0,17,0,0"/></StackPanel></Border>
<TextBlock Text="Защищённый вход · NEBULA CLEAN" Foreground="#566078" FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0"/></StackPanel></Grid></Window>